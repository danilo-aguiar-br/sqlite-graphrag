#!/usr/bin/env bash
# Mock claude code CLI for the LLM-only test suite.
#
# The real `claude` binary requires OAuth login and a network round-trip to
# Anthropic. Tests must run hermetically on CI runners, so we substitute a
# shell script that returns deterministic zero vectors in the requested
# dimensionality (fallback 64; G51: the dim is parsed from the prompt or from
# the schema, enabling end-to-end tests against databases of any width).
#
# The schema arrives in TWO shapes and both must be handled: codex passes
# `--output-schema <PATH>` (a tempfile) while claude passes `--json-schema
# <INLINE-JSON>` since Claude Code 2.1. Treating the argument as a path only
# made the inline form fall through to the 64 fallback, so every claude-backed
# test silently exercised 64 dims no matter what the database recorded.
#
# Two response shapes are supported, mirroring
# src/extract/llm_embedding.rs:
# - single: `{"embedding":[...]}` (EmbeddingResponse);
# - batch (G42/S2): `{"items":[{"i":N,"v":[...]}]}` when the prompt asks
#   for an "items" array containing EXACTLY N items.
#
# The prompt may arrive as an argv argument (claude -p) or on stdin;
# `python3 -c` keeps stdin free so both channels are inspected.
#
# ## Extraction mode (GAP-SG-148 item 3a)
#
# `ingest --mode claude-code` is NOT the embedding path: it spawns
# `claude -p <EXTRACTION_PROMPT>` and parses the Claude Code envelope
# (`[{"type":"system",...},{"type":"result","structured_output":{...}}]`)
# into `ExtractionResult`. This script used to answer that call with the
# embedding shape, so the mode had no hermetic coverage at all and the
# extraction-name collision it guards against could not be reproduced.
#
# The mode is selected by the extraction prompt itself, which is
# unmistakable, so the embedding branch below is reached exactly as before
# for every other caller. What the extraction reply contains is driven by
# directives read from the DOCUMENT BODY on stdin, which is what makes two
# distinct files able to return the SAME name:
#
#   MOCK_EXTRACTION_NAME: <kebab-name>          (default: mock-extraction)
#   MOCK_EXTRACTION_DESCRIPTION: <free text>    (default: fixed sentence)
#   MOCK_EXTRACTION_ENTITY: <name>:<entity_type>  (repeatable; default: none)
#
# Relationships are always emitted as an empty array: nothing under test
# needs them yet, and a fabricated edge would show up in graph assertions.
#
# `--version` answers with a version string instead of JSON. The version
# gate in `ingest_claude::binary` only enforces a minimum when the output
# parses as a semver, so the old JSON reply passed by accident; answering
# properly makes the gate actually exercised rather than skipped.

set -euo pipefail

if [[ "${1:-}" == "--version" ]]; then
  echo "2.1.0 (Claude Code mock)"
  exit 0
fi

ARGS="$*" python3 -c "
import json, os, re, sys

args = os.environ['ARGS']
body = ''
if not sys.stdin.isatty():
    body = sys.stdin.read()
text = args + ' ' + body

# Extraction path: reply with the Claude Code envelope, not a vector.
if 'knowledge graph entity extractor' in args:
    name = 'mock-extraction'
    nm = re.search(r'MOCK_EXTRACTION_NAME:\s*(\S+)', body)
    if nm:
        name = nm.group(1)
    description = 'mock extraction emitted by tests/mock-llm/claude'
    dm = re.search(r'MOCK_EXTRACTION_DESCRIPTION:\s*(.+)', body)
    if dm:
        description = dm.group(1).strip()
    entities = [
        {'name': ent, 'entity_type': kind}
        for ent, kind in re.findall(
            r'MOCK_EXTRACTION_ENTITY:\s*([^\s:]+)\s*:\s*(\S+)', body
        )
    ]
    envelope = [
        {'type': 'system', 'subtype': 'init', 'apiKeySource': 'none'},
        {
            'type': 'result',
            'is_error': False,
            'total_cost_usd': 0.0,
            'structured_output': {
                'name': name,
                'description': description,
                'entities': entities,
                'relationships': [],
            },
        },
    ]
    sys.stdout.write(json.dumps(envelope) + '\n')
    sys.exit(0)

# G51: honour the requested dimensionality instead of hardcoding 64.
# Batch prompts state it inline; the single path only carries it as the
# schema's minItems, which may be a file path OR the schema itself.
dim = 64
dm = re.search(r'(\d+)-dimensional', text)
if dm:
    dim = int(dm.group(1))
else:
    argv = text.split()
    schema = None
    for flag in ('--output-schema', '--json-schema'):
        if flag in argv:
            try:
                token = argv[argv.index(flag) + 1]
            except IndexError:
                break
            try:
                schema = open(token).read()
            except OSError:
                # Not a path: claude passes the schema as inline JSON.
                schema = token
            break
    # Last resort: the schema may reach us joined into the prompt text.
    sm = re.search(r'\"minItems\"\s*:\s*(\d+)', schema if schema else text)
    if sm:
        dim = int(sm.group(1))
m = re.search(r'EXACTLY (\d+) items', text)
if m:
    n = int(m.group(1))
    payload = {'items': [{'i': i + 1, 'v': [0.0] * dim} for i in range(n)]}
else:
    payload = {'embedding': [0.0] * dim}
sys.stdout.write(json.dumps(payload) + '\n')
"

exit 0
